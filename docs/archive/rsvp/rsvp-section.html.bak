    <!-- RSVP -->
    <section id="rsvp" class="rsvp-section">
      <div class="section section-panel section-panel--rsvp rsvp-section__inner reveal-parent">
        <h2 class="section-title reveal">
          RSVP
          <span class="section-title-telugu" lang="te">హాజరు నిర్ధారణ</span>
        </h2>
        <p class="rsvp__deadline reveal">Kindly respond by July 16, 2026</p>

        <div class="rsvp__frame-wrapper reveal">
          <form
            class="rsvp-form"
            id="rsvp-form"
            data-endpoint="https://script.google.com/macros/s/AKfycbyenxfTnpxzx2eKRe9qRjpjbxbxRQn4NXH-1MoM4ST3EdpsaN-3gb3Ud5WNU2uCO3otGw/exec"
            novalidate
          >
            <input type="hidden" name="attendance" id="rsvp-attendance" value="">
            <input type="text" name="website" class="rsvp-form__honeypot" tabindex="-1" autocomplete="off" aria-hidden="true">

            <div class="rsvp-form__field">
              <div class="rsvp-form__legend-row">
                <label class="rsvp-form__legend">Will you be joining us?</label>
                <span class="rsvp-form__required">*</span>
              </div>
              <div class="rsvp-form__choice-group" role="radiogroup" aria-label="Will you be joining us?">
                <button type="button" class="rsvp-form__choice" data-attendance-choice="yes" aria-pressed="false">Yes, I'll be there</button>
                <button type="button" class="rsvp-form__choice" data-attendance-choice="no" aria-pressed="false">Can't make it</button>
              </div>
            </div>

            <div class="rsvp-form__field">
              <div class="rsvp-form__legend-row">
                <label class="rsvp-form__legend" for="rsvp-name">Your name</label>
                <span class="rsvp-form__required">*</span>
              </div>
              <input id="rsvp-name" name="name" class="rsvp-form__input" type="text" placeholder="Your Name(s) here" required>
            </div>

            <div class="rsvp-form__followup" id="rsvp-followup" hidden>
              <div class="rsvp-form__field">
                <div class="rsvp-form__legend-row">
                  <label class="rsvp-form__legend" for="rsvp-party-size">Number of guests</label>
                  <span class="rsvp-form__required">*</span>
                </div>
                <input id="rsvp-party-size" name="party_size" class="rsvp-form__input" type="number" min="1" max="12" inputmode="numeric" placeholder="Including yourself" aria-describedby="rsvp-party-size-error" data-guest-cap="2">
                <p class="rsvp-form__field-error" id="rsvp-party-size-error" role="alert" hidden>
                  <span class="rsvp-form__field-error-icon" aria-hidden="true">!</span>
                  <span class="rsvp-form__field-error-text"></span>
                </p>
              </div>

              <div class="rsvp-form__field rsvp-form__field--checkboxes" role="group" aria-labelledby="rsvp-events-label">
                <div class="rsvp-form__legend-row">
                  <p class="rsvp-form__legend" id="rsvp-events-label">Which events will you attend?</p>
                  <span class="rsvp-form__required">*</span>
                </div>
                <label class="rsvp-form__check" data-event="ceremony">
                  <input type="checkbox" name="events" value="Wedding Ceremony">
                  <span>Wedding Ceremony</span>
                </label>
                <label class="rsvp-form__check" data-event="reception">
                  <input type="checkbox" name="events" value="Reception">
                  <span>Reception</span>
                </label>
              </div>

              <div class="rsvp-form__field">
                <label class="rsvp-form__legend" for="rsvp-dietary">Dietary restrictions or notes</label>
                <textarea id="rsvp-dietary" name="dietary_restrictions" class="rsvp-form__input rsvp-form__textarea" rows="3" placeholder="Optional — allergies, vegetarian, vegan, etc."></textarea>
              </div>
            </div>

            <div class="rsvp-form__actions">
              <button type="submit" class="rsvp-form__submit">Send RSVP →</button>
            </div>

            <p class="rsvp-form__status" id="rsvp-status" role="status" aria-live="polite"></p>
          </form>
        </div>

        <p class="rsvp__fallback">
          Having trouble? Email us at
          <a href="mailto:chadandanusha@gmail.com">chadandanusha@gmail.com</a>
        </p>
      </div>
    </section>

    <!-- INVITATION BORDER -->
    <div class="invitation-divider invitation-divider--rsvp-to-guide" aria-hidden="true">
      <img src="assets/images/stitch/divider-kolam-v3.png" class="floral-divider__strip" alt="" loading="lazy">
    </div>
